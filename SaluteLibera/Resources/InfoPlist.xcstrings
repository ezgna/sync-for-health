      "comment" : "Privacy - Health Share Usage Description",
      "localizations" : {
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Sync for Health reads only the Health data you authorize and sends it exclusively to the server you set up. Nobody else receives it: no ads, no analytics, no iCloud." } },
