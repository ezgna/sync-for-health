    "NSHealthShareUsageDescription": {
      "comment": "Privacy - Health Share Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthBridge reads only the Health data you authorize and sends it exclusively to the server you set up. Nobody else receives it: no ads, no analytics, no iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthBridge legge solo i dati di Salute che autorizzi e li invia esclusivamente al server che hai indicato tu. Nessun altro li riceve: niente pubblicità, niente analisi, niente iCloud."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription": {
      "comment": "Privacy - Health Update Usage Description",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthBridge does not write any data to Health."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "HealthBridge non scrive dati in Salute."
          }
        }
      }
    }
  },
  "version": "1.0"
